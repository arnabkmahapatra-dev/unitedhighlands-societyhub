# ---- SocietyHub environment configuration ----
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.

# Security: generate a strong random key, e.g. `openssl rand -hex 32`
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database (SQLite by default; swap for postgresql+psycopg URL in production)
DATABASE_URL=sqlite:///./societyhub.db

# Branding: name shown in the browser tab, login card and navbar
APP_NAME=SocietyHub

# CORS: comma-separated list of allowed origins for browsers / mobile web
CORS_ORIGINS=*

# ---- OTP / SMS ----
# Provider: console | twilio | msg91
# "console" logs the OTP to the server console (development only).
SMS_PROVIDER=console
# Set REQUIRE_OTP=false to allow signup/login WITHOUT OTP verification
# (useful until a real SMS/email OTP provider is configured). Default: true.
REQUIRE_OTP=true
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
# Cooldown between OTP requests to the same mobile (seconds)
OTP_RESEND_COOLDOWN_SECONDS=30

# Twilio (used when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# MSG91 (used when SMS_PROVIDER=msg91) — popular in India
MSG91_AUTH_KEY=
MSG91_SENDER=
MSG91_TEMPLATE_ID=
MSG91_ROUTE=4

# Default country code prepended to bare 10-digit numbers
DEFAULT_COUNTRY_CODE=+91

# ---- Seeded IT Support (super admin) account ----
DEFAULT_ADMIN_NAME=IT Support
DEFAULT_ADMIN_MOBILE=+919999999999
DEFAULT_ADMIN_PASSWORD=ChangeMe@123
